CLASS zcl_osd_shlp_zosd_h5x_uv DEFINITION PUBLIC FINAL CREATE PUBLIC.
* generated by tools/segw-shlp.mjs from the search help objects - do not edit
* The selection of the help view ZOSD_H5X_UV:
* a join, the language field of a text table bound to the session language.
  PUBLIC SECTION.
    INTERFACES zif_oao_shlp_source.
    TYPES: BEGIN OF ty_row,
             unit TYPE zosd_h5x_un-unit,
             ltxt TYPE zosd_h5x_unt-ltxt,
             dim  TYPE zosd_h5x_un-dim,
           END OF ty_row.
    TYPES ty_rows TYPE STANDARD TABLE OF ty_row WITH DEFAULT KEY.
ENDCLASS.

CLASS zcl_osd_shlp_zosd_h5x_uv IMPLEMENTATION.

  METHOD zif_oao_shlp_source~select.
    DATA lv_where TYPE string.
    DATA lv_rows TYPE i.
    FIELD-SYMBOLS <lt_rows> TYPE ty_rows.

    CREATE DATA rr_rows TYPE ty_rows.
    ASSIGN rr_rows->* TO <lt_rows>.
    lv_where = iv_where.
    IF lv_where IS INITIAL.
      lv_where = '1 = 1'.
    ENDIF.
* at most iv_maxrows rows in the key order, before the provider sorts them
    lv_rows = iv_maxrows.
    IF lv_rows <= 0.
      lv_rows = zcl_oao_shlp_ddic=>c_all_rows.
    ENDIF.
    SELECT t1~unit AS unit
           t2~ltxt AS ltxt
           t1~dim AS dim
      FROM zosd_h5x_un AS t1
        LEFT OUTER JOIN zosd_h5x_unt AS t2
          ON t2~client = t1~client
         AND t2~langu = iv_langu
         AND t2~unit = t1~unit
      INTO CORRESPONDING FIELDS OF TABLE <lt_rows>
      UP TO lv_rows ROWS
      WHERE ( t1~ext = 'X' ) AND (lv_where)
      ORDER BY t1~client t1~unit.
  ENDMETHOD.

  METHOD zif_oao_shlp_source~column.
    CASE to_upper( iv_field ).
      WHEN 'UNIT'.
        rv_column = 't1~unit'.
      WHEN 'LTXT'.
        rv_column = 't2~ltxt'.
      WHEN 'DIM'.
        rv_column = 't1~dim'.
      WHEN OTHERS.
* the provider refuses a field that is no parameter before it asks here
        CLEAR rv_column.
    ENDCASE.
  ENDMETHOD.

ENDCLASS.
