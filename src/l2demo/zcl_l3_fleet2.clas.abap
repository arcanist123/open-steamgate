CLASS zcl_l3_fleet2 IMPLEMENTATION.
  METHOD set_kill.
    DATA ls_kill TYPE zosd_l3_kill.
    DATA lt_report TYPE tt_doctor.
    DATA lv_reason TYPE string.
    lv_reason = iv_reason.
    CONDENSE lv_reason.
    IF lv_reason IS INITIAL OR strlen( iv_reason ) > 80.
      RETURN.
    ENDIF.
    ls_kill-set_name = c_set.
    ls_kill-reason = iv_reason.
    MODIFY zosd_l3_kill FROM ls_kill.
    act( EXPORTING iv_run = 'SET' iv_action = 'SET-KILL' iv_reason = iv_reason CHANGING ct_report = lt_report ).
    stop_daemon( ).
    watcher_audit( 'DMN-KILL' ).
    rv_ok = abap_true.
  ENDMETHOD.
  METHOD clear_kill.
    DATA lt_report TYPE tt_doctor.
    DATA lv_reason TYPE string.
    lv_reason = iv_reason.
    CONDENSE lv_reason.
    IF lv_reason IS INITIAL OR strlen( iv_reason ) > 80.
      RETURN.
    ENDIF.
    DELETE FROM zosd_l3_kill WHERE set_name = c_set.
    act( EXPORTING iv_run = 'SET' iv_action = 'CLEAR-KILL' iv_reason = iv_reason CHANGING ct_report = lt_report ).
    start_daemon( ).
    rv_ok = abap_true.
  ENDMETHOD.
  METHOD cockpit_reset_setting.
    DATA lv_note TYPE string.
    lv_note = iv_note.
    CONDENSE lv_note.
    IF lv_note IS INITIAL OR strlen( iv_note ) > 80.
      RETURN.
    ENDIF.
    rv_ok = zcl_l3_fleet2_conf=>reset_setting( iv_param = iv_param iv_note = iv_note ).
  ENDMETHOD.
  METHOD cockpit_schedule_status.
    DATA lv_driver TYPE string VALUE 'UNSCHEDULED'.
    DATA lv_doctor TYPE string VALUE 'UNSCHEDULED'.
    DATA ls_select TYPE btcselect.
    DATA lt_jobs TYPE STANDARD TABLE OF tbtcjob WITH DEFAULT KEY.
    DATA ls_job TYPE tbtcjob.
    ls_select-jobname = c_driver.
    ls_select-username = sy-uname.
    ls_select-schedul = 'X'.
    CALL FUNCTION 'BP_JOB_SELECT' EXPORTING jobselect_dialog = 'N' jobsel_param_in = ls_select
      TABLES jobselect_joblist = lt_jobs EXCEPTIONS OTHERS = 1.
    LOOP AT lt_jobs INTO ls_job WHERE status = 'S'.
      lv_driver = |SCHEDULED { ls_job-jobcount }|.
    ENDLOOP.
    CLEAR lt_jobs.
    ls_select-jobname = c_doctor.
    CALL FUNCTION 'BP_JOB_SELECT' EXPORTING jobselect_dialog = 'N' jobsel_param_in = ls_select
      TABLES jobselect_joblist = lt_jobs EXCEPTIONS OTHERS = 1.
    LOOP AT lt_jobs INTO ls_job WHERE status = 'S'.
      lv_doctor = |SCHEDULED { ls_job-jobcount }|.
    ENDLOOP.
    rv_status = |{ lv_driver } / { lv_doctor }|.
  ENDMETHOD.
  METHOD settings_seed.
    zcl_l3_fleet2_conf=>settings_seed( ).
  ENDMETHOD.
  METHOD set_setting.
    rv_ok = zcl_l3_fleet2_conf=>set_setting( iv_param = iv_param iv_value = iv_value iv_note = iv_note ).
  ENDMETHOD.
  METHOD reset_setting.
    rv_ok = zcl_l3_fleet2_conf=>reset_setting( iv_param ).
  ENDMETHOD.
  METHOD reset_settings.
    rv_ok = zcl_l3_fleet2_conf=>reset_all( ).
  ENDMETHOD.
  METHOD run.
    " stage by stage: a stage opens through its gate row in ZOSD_L3_STAGE
    " (WAITING to OPEN), is planned then (a later stage reads the worklist an
    " earlier one filled) and runs. Mode S runs every stage in this step and
    " stops at a stage that is not DONE; mode P submits the piles of the first
    " stage that has any, and the job that ends a stage opens the next one
    DATA lt_rules TYPE tt_rule.
    DATA ls_rule TYPE ty_rule.
    DATA lt_piles TYPE tt_pile.
    DATA ls_pile TYPE zosd_l3_pile.
    DATA ls_part TYPE ty_rule.
    DATA lt_stages TYPE tt_stage.
    DATA ls_stage TYPE ty_stage.
    DATA ls_gate TYPE zosd_l3_stage.
    DATA lv_stop TYPE abap_bool.
    DATA lv_open TYPE abap_bool.
    DATA lv_fused TYPE abap_bool.
    DATA lv_stamp TYPE timestampl.
    DATA lv_parallel TYPE abap_bool.
    DATA lx_error TYPE REF TO cx_root.
    DATA lv_dry TYPE abap_bool.
    DATA li_src_1 TYPE REF TO zif_l3_fleet2_ships.
    DATA lv_swap_1 TYPE abap_bool.
    DATA lt_keep_1 TYPE zif_l3_fleet2_ships=>tt_rows.
    DATA lt_scope_1 TYPE zif_l3_fleet2_ships=>tt_rows.
    FIELD-SYMBOLS <ls_row_1> TYPE zosd_l2_ship.
    " a dry run: every check in this step, nothing to the log (dry( ))
    IF iv_dry_run = abap_true.
      rs_result = dry( iv_date = iv_date
                       iv_bind = iv_bind
                       is_params = is_params
                       iv_allow_replay = iv_allow_replay ).
      RETURN.
    ENDIF.
    " a dry run (dry( ) runs this in mode S) reads the settings and writes
    " none: nothing seeded, logged or snapshot
    lv_dry = gv_dry.
    CLEAR gv_dry.
    IF lv_dry = abap_true.
      gs_settings = zcl_l3_fleet2_conf=>load( iv_write = abap_false ).
    ELSE.
      gs_settings = zcl_l3_fleet2_conf=>load( ).
    ENDIF.
    IF iv_mode = c_parallel.
      lv_parallel = abap_true.
    ENDIF.
    zcl_l3_fleet2_ports=>check( iv_bind = iv_bind
                          iv_parallel = lv_parallel
                          iv_allow_replay = iv_allow_replay ).
    rs_result-set_name = c_set.
    rs_result-mode = iv_mode.
    rs_result-settings_warnings = gs_settings-warnings.
    rs_result-bind = iv_bind.
    rs_result-params = is_params.
    rs_result-check_date = iv_date.
    TRY.
        rs_result-run_id = cl_system_uuid=>create_uuid_c32_static( ).
      CATCH cx_uuid_error.
        GET TIME STAMP FIELD lv_stamp.
        rs_result-run_id = lv_stamp.
    ENDTRY.
    gv_settings_run = rs_result-run_id.
    " the kill switch: while zosd_l3_kill holds a row of the set no run starts
    IF killed( ) = abap_true.
      rs_result-status = 'KILLED'.
      RETURN.
    ENDIF.
    " one run of the set per check date at a time: a run that finds the lock
    " held by another answers BUSY and plans nothing
    IF lock( iv_run = rs_result-run_id iv_date = rs_result-check_date ) = abap_false.
      rs_result-status = 'BUSY'.
      RETURN.
    ENDIF.
    budget_start( rs_result-run_id ).
    lt_rules = rules( ).
    " a source that is not live replaces table content for this run, and the
    " table is put back whatever happens: after the loop, or when an exception
    " leaves this method (CATCH and RAISE, which does what CLEANUP would; the
    " transpiler drops CLEANUP, ANORMALIES.md). Nothing in here commits.
    TRY.
        " zosd_l2_ship: the table's own rows are kept, the source's rows stand
        " in their place, and the rules read them as they read the table
        IF zcl_l3_fleet2_ports=>swaps( iv_port = 'ships' iv_bind = iv_bind ) = abap_true.
          li_src_1 = zcl_l3_fleet2_ports=>get_ships( zcl_l3_fleet2_ports=>variant( iv_port = 'ships' iv_bind = iv_bind ) ).
          SELECT * FROM zosd_l2_ship INTO TABLE lt_keep_1.
          lt_scope_1 = li_src_1->read( ).
          LOOP AT lt_scope_1 ASSIGNING <ls_row_1>.
            <ls_row_1>-mandt = sy-mandt.
          ENDLOOP.
          lv_swap_1 = abap_true.
          DELETE FROM zosd_l2_ship.
          INSERT zosd_l2_ship FROM TABLE lt_scope_1.
        ENDIF.
        IF lv_dry = abap_false.
          record_snapshot( iv_run = rs_result-run_id iv_name = 'ships_ref'
            iv_stage = 2 iv_bind = iv_bind iv_installed = abap_true ).
        ENDIF.
        IF lv_dry = abap_false.
          zcl_l3_fleet2_conf=>snapshot( iv_run = rs_result-run_id is_state = gs_settings ).
        ENDIF.
        " the gate rows: every stage WAITING; a stage opens once, WAITING to OPEN
        lt_stages = stages( ).
        ls_gate-set_name = c_set.
        ls_gate-run_id = rs_result-run_id.
        ls_gate-check_date = rs_result-check_date.
        ls_gate-status = 'WAITING'.
        " the binding the run starts with, and its work variant, on the run's
        " own rows: the lock row names only the latest run of a date
        ls_gate-run_bind = sim_record( iv_bind ).
        LOOP AT lt_stages INTO ls_stage.
          ls_gate-stage_no = ls_stage-stage_no.
          ls_gate-stage_name = ls_stage-stage.
          INSERT zosd_l3_stage FROM ls_gate.
        ENDLOOP.
        LOOP AT lt_stages INTO ls_stage.
          IF lv_stop = abap_true.
            " after a stage that did not end DONE, or after the stage whose
            " jobs were just submitted: not opened by this step
            ls_stage-status = 'WAITING'.
            LOOP AT lt_rules INTO ls_rule WHERE stage_no = ls_stage-stage_no.
              ls_rule-status = 'WAITING'.
              APPEND ls_rule TO rs_result-rules.
            ENDLOOP.
            APPEND ls_stage TO rs_result-stages.
            CONTINUE.
          ENDIF.
          GET TIME STAMP FIELD lv_stamp.
          UPDATE zosd_l3_stage SET status = 'OPEN' opened = lv_stamp
            WHERE set_name = c_set AND run_id = rs_result-run_id
              AND stage_no = ls_stage-stage_no
              AND status = 'WAITING'.
          lt_piles = plan( iv_run = rs_result-run_id
                           iv_date = rs_result-check_date
                           iv_stage = ls_stage-stage_no
                           iv_bind = iv_bind ).
          INSERT zosd_l3_pile FROM TABLE lt_piles.
          ls_stage-piles = lines( lt_piles ).
          IF iv_mode = c_parallel AND lt_piles IS NOT INITIAL.
            " mode P: this stage's piles as jobs; the job that ends the stage opens the next
            LOOP AT lt_rules INTO ls_rule WHERE stage_no = ls_stage-stage_no.
              ls_rule-status = 'SUBMITTED'.
              LOOP AT lt_piles INTO ls_pile WHERE rule_name = ls_rule-rule.
                ls_rule-piles = ls_rule-piles + 1.
                submit( EXPORTING iv_date = rs_result-check_date
                                  iv_run = rs_result-run_id
                                  iv_bind = iv_bind
                                  is_params = is_params
                                  iv_jobname = ls_rule-jobname
                        CHANGING cs_pile = ls_pile ).
                IF ls_pile-status = 'FAILED'.
                  ls_rule-status = 'PARTIAL'.
                ENDIF.
              ENDLOOP.
              APPEND ls_rule TO rs_result-rules.
            ENDLOOP.
            ls_stage-status = 'SUBMITTED'.
            lv_stop = abap_true.
            lv_open = abap_true.
          ELSE.
            " mode S, or a stage without a pile: every pile in this step. A
            " rule is DONE when every pile is, and only then finalised
            LOOP AT lt_rules INTO ls_rule WHERE stage_no = ls_stage-stage_no.
              CLEAR lv_fused.
              LOOP AT lt_piles INTO ls_pile WHERE rule_name = ls_rule-rule.
                ls_rule-piles = ls_rule-piles + 1.
                ls_part = run_rule( iv_rule = ls_rule-rule
                                    iv_date = rs_result-check_date
                                    iv_run = rs_result-run_id
                                    iv_pile = ls_pile-pile_no
                                    iv_bind = iv_bind is_params = is_params ).
                ls_rule-alerts = ls_rule-alerts + ls_part-alerts.
                ls_rule-keys = ls_rule-keys + ls_part-keys.
                ls_rule-failed = ls_rule-failed + ls_part-failed.
                ls_rule-piles_done = ls_rule-piles_done + ls_part-piles_done.
                IF ls_part-status = 'FUSED'.
                  lv_fused = abap_true.
                ENDIF.
              ENDLOOP.
              IF ls_rule-piles_done = ls_rule-piles.
                ls_rule-status = 'DONE'.
                finalise( iv_rule = ls_rule-rule
                          iv_hash = ls_rule-model_hash
                          iv_date = rs_result-check_date
                          iv_run = rs_result-run_id
                          iv_bind = iv_bind ).
              ELSE.
                ls_rule-status = 'PARTIAL'.
              ENDIF.
              " a pile past the fuse: the rule is FUSED and was not finalised
              IF lv_fused = abap_true.
                ls_rule-status = 'FUSED'.
              ENDIF.
              ls_stage-piles_done = ls_stage-piles_done + ls_rule-piles_done.
              rs_result-alerts = rs_result-alerts + ls_rule-alerts.
              APPEND ls_rule TO rs_result-rules.
            ENDLOOP.
            IF ls_stage-piles_done = ls_stage-piles.
              ls_stage-status = 'DONE'.
            ELSE.
              ls_stage-status = 'PARTIAL'.
              lv_stop = abap_true.
            ENDIF.
            GET TIME STAMP FIELD lv_stamp.
            UPDATE zosd_l3_stage SET status = ls_stage-status ended = lv_stamp
              WHERE set_name = c_set AND run_id = rs_result-run_id
                AND stage_no = ls_stage-stage_no.
          ENDIF.
          APPEND ls_stage TO rs_result-stages.
        ENDLOOP.
        " mode P holds the lock while a stage's jobs are open; else the run is final
        IF lv_open = abap_true.
          rs_result-status = 'SUBMITTED'.
        ELSE.
          rs_result-status = 'DONE'.
          LOOP AT rs_result-stages INTO ls_stage WHERE status <> 'DONE'.
            rs_result-status = 'PARTIAL'.
          ENDLOOP.
          release( iv_run = rs_result-run_id iv_date = rs_result-check_date ).
        ENDIF.
      CATCH cx_root INTO lx_error.
        release( iv_run = rs_result-run_id iv_date = rs_result-check_date ).
        IF lv_swap_1 = abap_true.
          restore_1( lt_keep_1 ).
        ENDIF.
        RAISE EXCEPTION lx_error.
    ENDTRY.
    IF lv_swap_1 = abap_true.
      restore_1( lt_keep_1 ).
    ENDIF.
    budget_counts( EXPORTING iv_run = rs_result-run_id CHANGING ct_rules = rs_result-rules ).
    IF budget_state( rs_result-run_id ) = 'GLASS'.
      rs_result-status = 'GLASS'.
    ENDIF.
    IF iv_mode = c_parallel AND rs_result-status = 'SUBMITTED'.
      start_daemon( ).
      " a daemon that is stopping is found and not started again; the run's first
      " release must not wait for it: a pass job of its own releases the first lanes
      watcher_pass( ).
    ENDIF.
  ENDMETHOD.

  METHOD plan.
    " the plan of one stage, made when the stage opens. A piled stage reads
    " its keys through its source port (over a worklist: the port's worklist
    " variant, the keys an earlier stage of this run filled), sorted and
    " without repeats, cut into consecutive chunks of its size; a rule that
    " is not piled is one pile, number 0, over every row. No key, no pile
    DATA lt_cut TYPE tt_pile.
    DATA ls_pile TYPE zosd_l3_pile.
    DATA lv_count TYPE i.
    DATA li_source_1 TYPE REF TO zif_l3_fleet2_ships.
    DATA lt_keys_1 TYPE zif_l3_fleet2_ships=>tt_rows.
    DATA ls_key_1 LIKE LINE OF lt_keys_1.
    DATA li_source_2 TYPE REF TO zif_l3_fleet2_ships.
    DATA lt_keys_2 TYPE zif_l3_fleet2_ships=>tt_rows.
    DATA ls_key_2 LIKE LINE OF lt_keys_2.
    ls_pile-set_name = c_set.
    ls_pile-run_id = iv_run.
    ls_pile-check_date = iv_date.
    ls_pile-stage_no = iv_stage.
    ls_pile-status = 'PLANNED'.
    CASE iv_stage.
      WHEN 1.
        li_source_1 = zcl_l3_fleet2_ports=>get_ships( zcl_l3_fleet2_ports=>variant( iv_port = 'ships' iv_bind = iv_bind ) ).
        lt_keys_1 = li_source_1->read( ).
        SORT lt_keys_1 BY ship_id.
        DELETE ADJACENT DUPLICATES FROM lt_keys_1 COMPARING ship_id.
        LOOP AT lt_keys_1 INTO ls_key_1.
          IF lv_count = 0.
            ls_pile-pile_no = ls_pile-pile_no + 1.
            ls_pile-range_low = ls_key_1-ship_id.
          ENDIF.
          ls_pile-range_high = ls_key_1-ship_id.
          lv_count = lv_count + 1.
          IF lv_count = 2.
            APPEND ls_pile TO lt_cut.
            lv_count = 0.
          ENDIF.
        ENDLOOP.
        IF lv_count > 0.
          APPEND ls_pile TO lt_cut.
        ENDIF.
        " ship-busy: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_1.
          ls_pile-model_hash = c_hash_1.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
      WHEN 2.
        " the keys worklist busy holds for this run
        zcl_l3_fleet2_ships_worklist=>use( iv_run = iv_run iv_worklist = 'busy' ).
        li_source_2 = zcl_l3_fleet2_ports=>get_ships( 'worklist' ).
        lt_keys_2 = li_source_2->read( ).
        SORT lt_keys_2 BY ship_id.
        DELETE ADJACENT DUPLICATES FROM lt_keys_2 COMPARING ship_id.
        LOOP AT lt_keys_2 INTO ls_key_2.
          IF lv_count = 0.
            ls_pile-pile_no = ls_pile-pile_no + 1.
            ls_pile-range_low = ls_key_2-ship_id.
          ENDIF.
          ls_pile-range_high = ls_key_2-ship_id.
          lv_count = lv_count + 1.
          IF lv_count = gs_settings-vals-piles_checks_size.
            APPEND ls_pile TO lt_cut.
            lv_count = 0.
          ENDIF.
        ENDLOOP.
        IF lv_count > 0.
          APPEND ls_pile TO lt_cut.
        ENDIF.
        " maintenance-ship-no-future-voyage: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_2.
          ls_pile-model_hash = c_hash_2.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
        " grounded-ship-keeps-only-keepers: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_3.
          ls_pile-model_hash = c_hash_3.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
        " ship-in-service-has-a-captain: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_4.
          ls_pile-model_hash = c_hash_4.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
        " ship-too-many-future-voyages: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_5.
          ls_pile-model_hash = c_hash_5.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
        " ship-min-crew: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_6.
          ls_pile-model_hash = c_hash_6.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
        " ship-cargo-limit: piled, its range: is the key
        LOOP AT lt_cut INTO ls_pile.
          ls_pile-rule_name = c_rule_7.
          ls_pile-model_hash = c_hash_7.
          APPEND ls_pile TO rt_piles.
        ENDLOOP.
    ENDCASE.
  ENDMETHOD.

  METHOD stages.
    DATA ls_stage TYPE ty_stage.
    ls_stage-stage_no = 1.
    ls_stage-stage = c_stage_1.
    APPEND ls_stage TO rt_stages.
    ls_stage-stage_no = 2.
    ls_stage-stage = c_stage_2.
    APPEND ls_stage TO rt_stages.
  ENDMETHOD.

  METHOD advance.
    " every pile of stage iv_stage DONE: the stage is DONE and the next one
    " opens. The gate is one UPDATE from WAITING to OPEN, so of two jobs that
    " end the stage at once only the one that gets sy-dbcnt = 1 plans and
    " submits it. A stage without a pile is DONE at once and the one after it
    " opens; past the last stage the run is complete: every rule finalised
    " (all are DONE) and the lock released
    DATA lt_piles TYPE tt_pile.
    DATA ls_pile TYPE zosd_l3_pile.
    DATA lt_rules TYPE tt_rule.
    DATA ls_rule TYPE ty_rule.
    DATA lv_stage TYPE i.
    DATA lv_stamp TYPE timestampl.
    " the kill switch: no gate opens while it is set; resume( ) opens it later
    IF killed( ) = abap_true.
      RETURN.
    ENDIF.
    IF budget_state( iv_run ) = 'GLASS'.
      RETURN.
    ENDIF.
    SELECT COUNT(*) FROM zosd_l3_pile
      WHERE set_name = c_set
        AND run_id = iv_run
        AND stage_no = iv_stage
        AND status <> 'DONE'.
    IF sy-dbcnt > 0.
      RETURN.
    ENDIF.
    GET TIME STAMP FIELD lv_stamp.
    UPDATE zosd_l3_stage SET status = 'DONE' ended = lv_stamp
      WHERE set_name = c_set AND run_id = iv_run
        AND stage_no = iv_stage
        AND status = 'OPEN'.
    lt_rules = rules( ).
    lv_stage = iv_stage + 1.
    WHILE lv_stage <= c_stages.
      UPDATE zosd_l3_stage SET status = 'OPEN' opened = lv_stamp
        WHERE set_name = c_set AND run_id = iv_run
          AND stage_no = lv_stage
          AND status = 'WAITING'.
      IF sy-dbcnt <> 1.
        RETURN.
      ENDIF.
      rv_opened = abap_true.
      lt_piles = plan( iv_run = iv_run
                       iv_date = iv_date
                       iv_stage = lv_stage
                       iv_bind = iv_bind ).
      INSERT zosd_l3_pile FROM TABLE lt_piles.
      IF lt_piles IS NOT INITIAL.
        LOOP AT lt_piles INTO ls_pile.
          READ TABLE lt_rules INTO ls_rule WITH KEY rule = ls_pile-rule_name.
          submit( EXPORTING iv_date = iv_date
                            iv_run = iv_run
                            iv_bind = iv_bind
                            is_params = is_params
                            iv_jobname = ls_rule-jobname
                  CHANGING cs_pile = ls_pile ).
        ENDLOOP.
        RETURN.
      ENDIF.
      UPDATE zosd_l3_stage SET status = 'DONE' ended = lv_stamp
        WHERE set_name = c_set AND run_id = iv_run
          AND stage_no = lv_stage.
      lv_stage = lv_stage + 1.
    ENDWHILE.
    LOOP AT lt_rules INTO ls_rule.
      finalise( iv_rule = ls_rule-rule
                iv_hash = ls_rule-model_hash
                iv_date = iv_date
                iv_run = iv_run
                iv_bind = iv_bind ).
    ENDLOOP.
    release( iv_run = iv_run iv_date = iv_date ).
  ENDMETHOD.

  METHOD fill.
    " a filter rule's keys go into the run's worklist, MODIFY on the full
    " key, so a retried pile writes the same rows; the alert log gets none
    DATA ls_work TYPE zosd_l3_work.
    DATA lv_key TYPE string.
    ls_work-set_name = c_set.
    ls_work-run_id = iv_run.
    ls_work-worklist = iv_worklist.
    ls_work-check_date = iv_date.
    LOOP AT it_keys INTO lv_key.
      ls_work-key_value = lv_key.
      MODIFY zosd_l3_work FROM ls_work.
      IF sy-subrc <> 0.
        cs_rule-failed = cs_rule-failed + 1.
      ENDIF.
    ENDLOOP.
    cs_rule-keys = lines( it_keys ).
    IF cs_rule-failed = 0.
      cs_rule-status = 'DONE'.
    ELSE.
      cs_rule-status = 'WRITE-FAILED'.
    ENDIF.
  ENDMETHOD.

  METHOD range_1.
    DATA ls_range LIKE LINE OF rt_range.
    IF is_pile-pile_no = 0.
      RETURN.
    ENDIF.
    ls_range-sign = 'I'.
    ls_range-low = is_pile-range_low.
    IF is_pile-range_high = is_pile-range_low.
      ls_range-option = 'EQ'.
    ELSE.
      ls_range-option = 'BT'.
      ls_range-high = is_pile-range_high.
    ENDIF.
    APPEND ls_range TO rt_range.
  ENDMETHOD.

  METHOD range_2.
    " a pile over a worklist is the worklist's keys between its bounds, each
    " I EQ: a key between them that the filter did not select stays out
    DATA lt_values TYPE STANDARD TABLE OF zosd_l3_work-key_value WITH DEFAULT KEY.
    DATA lv_value TYPE zosd_l3_work-key_value.
    DATA ls_range LIKE LINE OF rt_range.
    IF is_pile-pile_no = 0.
      RETURN.
    ENDIF.
    ls_range-sign = 'I'.
    ls_range-option = 'EQ'.
    SELECT key_value FROM zosd_l3_work INTO TABLE lt_values
      WHERE run_id = is_pile-run_id
        AND worklist = 'busy'
        AND key_value BETWEEN is_pile-range_low AND is_pile-range_high.
    LOOP AT lt_values INTO lv_value.
      ls_range-low = lv_value.
      APPEND ls_range TO rt_range.
    ENDLOOP.
    IF rt_range IS NOT INITIAL.
      RETURN.
    ENDIF.
    " no worklist row left: the bounds the plan recorded, each a key it held
    ls_range-low = is_pile-range_low.
    APPEND ls_range TO rt_range.
    ls_range-low = is_pile-range_high.
    APPEND ls_range TO rt_range.
  ENDMETHOD.

  METHOD sim_keys_1.
    DATA li_source TYPE REF TO zif_l3_fleet2_ships.
    DATA lt_rows TYPE zif_l3_fleet2_ships=>tt_rows.
    DATA ls_row LIKE LINE OF lt_rows.
    DATA lv_key TYPE string.
    IF it_range IS INITIAL.
      RETURN.
    ENDIF.
    li_source = zcl_l3_fleet2_ports=>get_ships( zcl_l3_fleet2_ports=>variant( iv_port = 'ships' iv_bind = iv_bind ) ).
    lt_rows = li_source->read( it_range ).
    LOOP AT lt_rows INTO ls_row.
      lv_key = ls_row-ship_id.
      APPEND lv_key TO rt_keys.
    ENDLOOP.
    SORT rt_keys.
    DELETE ADJACENT DUPLICATES FROM rt_keys.
  ENDMETHOD.

  METHOD sim_keys_2.
    DATA li_source TYPE REF TO zif_l3_fleet2_ships.
    DATA lt_rows TYPE zif_l3_fleet2_ships=>tt_rows.
    DATA ls_row LIKE LINE OF lt_rows.
    DATA lv_key TYPE string.
    IF it_range IS INITIAL.
      RETURN.
    ENDIF.
    li_source = zcl_l3_fleet2_ports=>get_ships( zcl_l3_fleet2_ports=>variant( iv_port = 'ships' iv_bind = iv_bind ) ).
    lt_rows = li_source->read( it_range ).
    LOOP AT lt_rows INTO ls_row.
      lv_key = ls_row-ship_id.
      APPEND lv_key TO rt_keys.
    ENDLOOP.
    SORT rt_keys.
    DELETE ADJACENT DUPLICATES FROM rt_keys.
  ENDMETHOD.

  METHOD sim_hash.
    rv_hash = iv_hash.
    IF strlen( rv_hash ) > 7 AND rv_hash(7) = 'sha256:'.
      CONCATENATE 'sim256:' rv_hash+7 INTO rv_hash.
    ENDIF.
  ENDMETHOD.

  METHOD sim_bind.
    SELECT SINGLE run_bind FROM zosd_l3_stage INTO rv_bind
      WHERE run_id = iv_run
        AND stage_no = 1.
    IF rv_bind IS NOT INITIAL.
      RETURN.
    ENDIF.
    " no binding recorded: a run from before the record, or one made by
    " hand. It is real, the only kind there was, never the factory's default
    IF iv_bind IS INITIAL.
      rv_bind = `work=real`.
    ELSE.
      rv_bind = iv_bind && `,work=real`.
    ENDIF.
  ENDMETHOD.

  METHOD sim_recorded.
    DATA lv_bind TYPE zosd_l3_stage-run_bind.
    SELECT SINGLE run_bind FROM zosd_l3_stage INTO lv_bind
      WHERE run_id = iv_run
        AND stage_no = 1.
    IF lv_bind IS NOT INITIAL.
      rv_recorded = abap_true.
    ENDIF.
  ENDMETHOD.

  METHOD sim_record.
    DATA lv_work TYPE string.
    lv_work = zcl_l3_fleet2_ports=>variant( iv_port = 'work' iv_bind = iv_bind ).
    IF sim_named( iv_bind ) IS NOT INITIAL.
      rv_bind = iv_bind.
    ELSEIF iv_bind IS INITIAL.
      rv_bind = `work=` && lv_work.
    ELSE.
      rv_bind = iv_bind && `,work=` && lv_work.
    ENDIF.
  ENDMETHOD.

  METHOD sim_named.
    DATA lt_parts TYPE string_table.
    DATA lv_part TYPE string.
    DATA lv_name TYPE string.
    DATA lv_value TYPE string.
    DATA lv_bind TYPE string.
    lv_bind = iv_bind.
    SPLIT lv_bind AT ',' INTO TABLE lt_parts.
    LOOP AT lt_parts INTO lv_part.
      CLEAR: lv_name, lv_value.
      SPLIT lv_part AT '=' INTO lv_name lv_value.
      CONDENSE: lv_name, lv_value.
      IF lv_name = 'work'.
        rv_variant = lv_value.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD restore_1.
    DELETE FROM zosd_l2_ship.
    INSERT zosd_l2_ship FROM TABLE it_keep.
  ENDMETHOD.

  METHOD save_pile.
    IF iv_owned = abap_true AND owns_pile( is_pile ) = abap_false.
      RETURN.
    ENDIF.
    UPDATE zosd_l3_pile SET status = is_pile-status alerts = is_pile-alerts
      started = is_pile-started ended = is_pile-ended
      job_name = is_pile-job_name job_count = is_pile-job_count
      attempt = is_pile-attempt reason = is_pile-reason
      hits = is_pile-hits closed = is_pile-closed open_alerts = is_pile-open_alerts
      WHERE set_name = c_set AND run_id = is_pile-run_id
        AND rule_name = is_pile-rule_name AND pile_no = is_pile-pile_no.
  ENDMETHOD.

