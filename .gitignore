# Local, never committed
.local/
.env
cookies.txt
.mcp.json

# Captures carry real logons / session GUIDs / credentials — never commit
*.pcap
*.jsonl
captures/

# Node / transpiler substrate
# without the trailing slash as well: in an OSD worktree this is a symlink
# to the checkout's own, and a rule ending in / matches directories only, so
# the shared dependencies showed up as an untracked file on that branch
node_modules/
node_modules
# `/output` and not `output/`: the build makes it a DIRECTORY on one host and
# a SYMLINK into build/live/ on another, and a rule ending in a slash matches
# only the directory. So the symlink sat untracked all day and `git add -A`
# would have committed a link into an untracked build folder.
/output
deps/
dist/
build/
*.sqlite
*.db
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Playwright
test-results/
playwright-report/

# generated from src/cds by tools/cds2ddic.mjs
gen/

# generated by scripts/build-preview.mjs
web/generated/
.segw-cloud.abaplint.json

# the cross-reference tables of OSD are derived from the parse, not authored,
# and every host seeds them at start (tools/osd-xref-seed.mjs); these names
# were the seed files of the retired `osd:xref -- --write`, kept ignored so a
# leftover copy does not look like work (test/xref-seed.mjs refuses one)
data/cross.tabu.json
data/wbcrossgt.tabu.json
data/wbcrossgtx.tabu.json
data/d010inc.tabu.json

# objects brought into the local system from a repository (npm run osd:import)
local/

# what a pack fetches rather than carries (tools/osd-fetch.mjs): the folder
# named upstream/ by convention, and the marker saying which commit it holds
packs/*/upstream
packs/*/games
packs/*/.osd-fetched.json
packs/*/.osd-fetch-*
docker/workbench/ide-password.txt

# Trace navigation companions are generated locally. Only L3 operational
# outputs and the check-class versions its stale/history readers use are kept.
*.trace.meta.json
!/src/l2demo/zcl_l3_*.trace.meta.json
!/src/l2demo/zcx_l3_*.trace.meta.json
!/src/l2demo/zif_l3_*.trace.meta.json
!/src/l2demo/zl3_*.trace.meta.json
!/src/l2demo/zl3c_*.trace.meta.json
!/src/l2demo/zcl_zl3c_*.trace.meta.json
!/src/l2demo/cockpit/**/*.trace.meta.json
# L2 check classes referenced by fleet{,2,3}.l3.yaml (not their testclasses).
!/src/l2demo/zcl_l2_maintenance_ship.clas.trace.meta.json
!/src/l2demo/zcl_l2_grounded_ship_crew.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_captain.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_voyage_limit.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_min_crew.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_cargo_limit.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_max_cargo.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_busy.clas.trace.meta.json
!/src/l2demo/zcl_l2_ship_restricted.clas.trace.meta.json

# Public RAP oracle sources remain local, never bundled
corpus-rap/
