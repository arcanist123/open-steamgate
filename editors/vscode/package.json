      "editor/title": [
        {"command": "osd.check", "when": "!isWeb && !osd.web && resourceFilename =~ /\\.(clas|prog|intf)(\\.(locals_def|locals_imp|macros|testclasses))?\\.abap$/i", "group": "navigation@0"},
        {"command": "osd.activate", "when": "!isWeb && !osd.web && resourceFilename =~ /\\.(clas|prog|intf)(\\.(locals_def|locals_imp|macros|testclasses))?\\.abap$/i", "group": "navigation@0.5"},
