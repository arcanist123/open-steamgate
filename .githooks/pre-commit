#!/bin/sh
# Look at what is staged before it becomes a commit. See tools/osd-leak-scan.mjs.
#
# This one only tells you. It does not stop the commit, because a local commit
# goes nowhere and stopping it buys nothing but friction — the gate that counts
# is pre-push, which checks everything the push would actually publish. Commit
# as freely as you like and clean the history before it leaves.
root=$(git rev-parse --show-toplevel)

# The scanner may not live in the repository being pushed. A sibling Go clone
# takes the same captures and deserves the same check, and the way to give it
# one is a shared core.hooksPath — so the tool is looked for next to this hook
# first, and only then in the repository itself.
hook_dir=$(cd "$(dirname "$0")" && pwd)
for candidate in "$hook_dir/../tools/osd-leak-scan.mjs" "$root/tools/osd-leak-scan.mjs"; do
  if [ -f "$candidate" ]; then scanner="$candidate"; break; fi
done
if [ -z "${scanner:-}" ]; then
  echo "osd-leak-scan: не нашёл сканер рядом с хуком — проверка не выполнена" >&2
  exit 0
fi

node "$scanner" "$root"
if [ $? -ne 0 ]; then
  echo "Это только предупреждение — коммит пройдёт. Остановит pre-push."
fi

# The size budget, as a yellow warning: you see a monolith growing at commit
# time, and pre-push is what stops it (Alice, 2026-10-02).
if [ -f "$root/tools/osd-size-budget.mjs" ] && [ -f "$root/tools/osd-size-budget.json" ]; then
  # --changed: the same attribution pre-push makes, so the warning names only
  # what this branch touched (no fetch here; origin/main as last fetched)
  out=$(node "$root/tools/osd-size-budget.mjs" --changed origin/main --warn 2>&1)
  case "$out" in
    *"breach(es)"*" (advisory)"*)
      printf '\033[33m%s\033[0m\n' "$out" >&2
      printf '\033[33m%s\033[0m\n' "osd-size-budget: только предупреждение — коммит пройдёт, pre-push остановит." >&2 ;;
  esac
fi
# Type forms abapiti cannot lower: the same yellow advisory as the size budget.
if [ -f "$root/tools/gogen/abapiti-lint.mjs" ] && [ -f "$root/tools/gogen/abapiti-lint.json" ]; then
  out=$(node "$root/tools/gogen/abapiti-lint.mjs" --check --changed origin/main --warn 2>&1)
  case "$out" in
    *"breach(es)"*" (advisory)"*)
      printf '\033[33m%s\033[0m\n' "$out" >&2
      printf '\033[33m%s\033[0m\n' "abapiti-lint: только предупреждение — коммит пройдёт, pre-push остановит." >&2 ;;
  esac
fi
exit 0
