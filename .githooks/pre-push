#!/bin/sh
# The gate that matters. A commit stays on this machine; a push does not.
#
# Committing freely to a local branch and cleaning the history before it goes
# anywhere is a good way to work — but only if something checks at the moment
# it goes. That moment is here, and what it checks is the range actually being
# pushed, every commit in it, not the working tree: a leak introduced in one
# commit and scrubbed in the next leaves a clean tree and a history that still
# carries it, and the push publishes the history.
#
# Commit messages are scanned too. They are as public as the files and are the
# easiest place to paste an address into without thinking about it.
root=$(git rev-parse --show-toplevel)
status=0

# Resolve operation markers through Git: .git can be a file in a worktree.
for operation in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if [ -e "$(git rev-parse --git-path "$operation")" ]; then
    echo "Push refused: unfinished Git operation ($operation). Finish or abort it first." >&2
    exit 1
  fi
done
if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
  echo "Push refused: unmerged paths remain. Resolve them before pushing." >&2
  exit 1
fi

# Check every destination before scanning any range. Keep stdin for the scanner
# loop below. Refresh origin/main once here: the empty-branch check and the
# size budget below both compare against it (a failed fetch keeps the cached ref).
push_refs=$(cat)
git -C "$root" fetch --quiet origin main 2>/dev/null || true
main_sha=$(git rev-parse --verify refs/remotes/origin/main 2>/dev/null) || main_sha=
if [ "${OSD_PUSH_ALLOW_EMPTY:-}" != 1 ] && [ -n "$main_sha" ]; then
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$local_sha" in
      ''|0000000000000000000000000000000000000000) continue ;;
    esac
    [ "$remote_ref" = refs/heads/main ] && continue
    if [ "$local_sha" = "$main_sha" ] ||
       [ "$(git rev-list --count "$main_sha..$local_sha")" = 0 ]; then
      echo "Push refused: $remote_ref has no commits over origin/main. Set OSD_PUSH_ALLOW_EMPTY=1 for an intentional empty branch." >&2
      exit 1
    fi
  done <<EOF
$push_refs
EOF
fi

# The scanner may not live in the repository being pushed. A sibling Go clone
# takes the same captures and deserves the same check, and the way to give it
# one is a shared core.hooksPath — so the tool is looked for next to this hook
# first, and only then in the repository itself.
hook_dir=$(cd "$(dirname "$0")" && pwd)
for candidate in "$hook_dir/../tools/osd-leak-scan.mjs" "$root/tools/osd-leak-scan.mjs"; do
  if [ -f "$candidate" ]; then scanner="$candidate"; break; fi
done
if [ -z "${scanner:-}" ]; then
  echo "osd-leak-scan: не нашёл сканер рядом с хуком — проверка не выполнена" >&2
  exit 0
fi

while read -r _local_ref local_sha _remote_ref remote_sha && [ -n "$local_sha" ]; do
  # A deletion has nothing to look at.
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac

  case "$remote_sha" in
    # A branch the remote has never seen: everything on it is new. Limited to
    # what is not already on another remote branch, so a first push of a topic
    # does not rescan the whole repository.
    0000000000000000000000000000000000000000)
      range="$local_sha --not --remotes=origin"
      ;;
    *)
      range="$remote_sha..$local_sha"
      ;;
  esac

  # shellcheck disable=SC2086
  node "$scanner" "$root" --range $range || rc=$?
  case "${rc:-0}" in
    0|2) ;;          # 2 = ran without the identifier list, which is CI's normal state
    *) status=1 ;;
  esac
  rc=0
done <<EOF
$push_refs
EOF

# The size budget (tools/osd-size-budget.mjs): monoliths may shrink, never
# grow. It measures the working tree, which is what a push of the current
# branch carries, and stops only on what the branch itself touched since it
# left main: a breach that is already on main (CI is advisory, so one can
# land) is printed in yellow and does not block an unrelated push. A budget
# raised against the merge base needs a reason.
budget=0
if [ -f "$root/tools/osd-size-budget.mjs" ] && [ -f "$root/tools/osd-size-budget.json" ]; then
  node "$root/tools/osd-size-budget.mjs" --changed origin/main || budget=1
fi

# abapiti's type-form ratchet, attributed to this branch like the size budget.
abapiti=0
if [ -f "$root/tools/gogen/abapiti-lint.mjs" ] && [ -f "$root/tools/gogen/abapiti-lint.json" ]; then
  node "$root/tools/gogen/abapiti-lint.mjs" --check --changed origin/main || abapiti=1
fi

if [ $status -ne 0 ]; then
  echo ""
  echo "Пуш остановлен. Это уйдёт в публичный репозиторий."
  echo "Почисти историю (rebase/squash) и попробуй снова."
fi
if [ $budget -ne 0 ]; then
  echo ""
  echo "Пуш остановлен: бюджет размера (tools/osd-size-budget.json)."
  echo "Вынеси код в отдельный пакет или подними бюджет с причиной."
  status=1
fi
if [ $abapiti -ne 0 ]; then
  printf '\033[31m%s\033[0m\n' "Push refused: abapiti type-form budget (tools/gogen/abapiti-lint.json)." >&2
  printf '\033[31m%s\033[0m\n' "Use the safe forms in tools/gogen/abapiti-lint.md." >&2
  status=1
fi
exit $status
