{
  "global": {
    "files": "/{src,packs/zvdb/src,test,gen/bsp,gen/cds,gen/segw,gen/rfc,gen/tran,gen/rap}/**/*.*",
    "errorOnDuplicateFilenames": true,
    "exclude": ["/test/e2e/", "/src/.*/cockpit/", "/test/fixtures/", "\\.mjs$", "\\.cjs$", "\\.stg\\.yaml$", "\\.l2\\.yaml$", "\\.l3\\.yaml$", "\\.samc\\.model\\.json$", "\\.samc\\.decl\\.json$", "\\.trace(?:\\.meta)?\\.json$"]
  },
  "dependencies": [
    {
      "folder": "/gen/stg",
      "files": "/**/*.*"
    },
    {
      // the converted reports and their ZIF_OSD_TRANSACTION wrappers
      // (tools/osd-gui-convert.mjs, docs/gui-reports.md) -- not in
      // "global" the way gen/tran is, the same reason gen/stg has its own
      // entry rather than being added there
      "folder": "/gen/gui",
      "files": "/**/*.*"
    },
    {
      // everything but src/tcp: open-abap-apc carries the APC family, with
      // the five methods and the alias chain a real handler needs, and core
      // still has the two-method version. Two of the same file is an error,
      // so core's is the one that goes.
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/.local/lars/open-abap-core",
      "files": "/src/{abap,adbc,bcs,bigint,classrun,conv,date_time,ddic,demo,exceptions,fdt,fugr,http,ixml,json,kernel,memory,numberrange,oauth2,oo,package,persistence,rtti,shma,smim,sxml,unit,uuid,w3mi,xco}/**/*.*"
    },
    {
      // and the ones that sit at the root of src rather than in a folder
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/.local/lars/open-abap-core",
      "files": "/src/*.*"
    },
    {
      "url": "https://github.com/open-abap/express-icf-shim",
      "folder": "/.local/lars/express-icf-shim",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/open-abap/open-abap-odata",
      "folder": "/.local/lars/open-abap-odata",
      "files": "/src/{oo,ddic,exceptions,internal}/**/!(#iwbep#if_mgw_odata_action.intf.*|#iwbep#if_mgw_odata_parameter.intf.*|zcl_oao_action.clas.*)"
    },
    {
      // Portable, untyped JSON tree used behind OSG's own regression
      // matcher facade. The public kernel never exposes ZIF_AJSON types.
      "url": "https://github.com/sbcgua/ajson",
      "folder": "/.local/lars/ajson",
      "files": "/src/core/**/*.*"
    },
    {
      // ABAP Push Channels: the SAP-named family a real websocket handler
      // implements (five methods where core has two, the alias chain that
      // carries co_connect_mode_accept) and the host that drives one off
      // stack.
      //
      // **The url is not decoration.** This entry said "local only for now,
      // which is why there is no url to clone" and the repository had been
      // public since 2026-09-14, with abap_transpile.json cloning it by url
      // all along. On a workstation the folder is there and the comment was
      // never read again; on a clean runner abaplint could not resolve
      // cl_apc_wsp_ext_stateful_base and the whole lint step failed on one
      // issue. A dependency that only resolves where somebody already
      // cloned it is a dependency nobody else can check.
      "url": "https://github.com/oisee/open-abap-apc",
      "folder": "/.local/lars/open-abap-apc",
      "files": "/src/{apc,host}/**/*.*"
    },
    {
      // the pack, delta and zlib half of abapGit, the objects
      // abap_transpile.json takes as a library; zcl_osd_git calls them
      "url": "https://github.com/abapGit/abapGit",
      "folder": "/.local/lars/abapgit",
      "files": "/{src/{git/{*.*,v2/*.*},utils/*.*,objects/aff_types/*.*,ui/progress/zif_abapgit_progress.*,ui/core/{zif_abapgit_html_viewer,zcl_abapgit_html_viewer_gui,zcl_abapgit_gui_event,zif_abapgit_gui_event,zif_abapgit_gui_event_handler,zif_abapgit_gui_services,zif_abapgit_gui_hotkeys,zif_abapgit_gui_hotkey_ctl,zif_abapgit_gui_renderable,zif_abapgit_html,zcl_abapgit_html,zcl_abapgit_html_parts}.*,zcx_abapgit_exception.*,zcx_abapgit_not_found.*,zcx_abapgit_type_not_supported.*,zif_abapgit_definitions.*,zif_abapgit_version.*},deps/{trobjtype.dtel.xml,trnspace.tabl.xml,dokil.tabl.xml}}"
    },
    {
      // The SAP GUI control classes as ABAP substitutes: cl_gui_html_viewer,
      // the containers, cl_gui_alv_grid, the trees, cl_gui_frontend_services.
      // Same shape as open-abap-core above -- SAP-namespace shim code, a
      // library and not a pack (docs/webgui.md).
      //
      // Only /src is the library. The repository also carries /framework
      // (a dynpro host of its own), /examples (the example programs) and
      // /test, and none of it belongs in this tree. Three files under
      // /framework are the exception: /src refers to them by name, so they
      // are closure and not example -- cl_ctmenu and cl_gui_toolbar keep
      // their items in zcl_gg_context_menu_state, and the tree and grid
      // controls render through zcl_gg_host_surface, which asks
      // zcl_gg_host_html for a CSS class. They would be library files
      // upstream; naming them here costs three lines and keeps the rest out.
      "url": "https://github.com/oisee/open-abap-gui",
      "folder": "/.local/lars/open-abap-gui",
      // gui-reports spike (docs/gui-reports.md): the converted-report bridge
      // drives zcl_gg_host_runtime, which reaches nearly all of framework/ --
      // node tools/osd-closure.mjs .local/lars/open-abap-gui/framework
      // zcl_gg_host_runtime says 45 of 50. Kept as an explicit allow-list of
      // subfolders (the open-abap-core entry above does the same for
      // src/tcp) rather than framework/** with an exclude, both because a
      // per-dependency exclude is not a key this file's other entries use
      // and to leave framework/http and framework/assets out for the same
      // reason abap_transpile.json does (docs/webgui.md: a dynpro host of
      // its own, not this bridge's territory) -- *.clas.testclasses.abap
      // never matches *.clas.abap, so a test class is never pulled in as a
      // dependency by accident.
      "files": "/{src/**/*.*,framework/{*.clas.abap,*.intf.abap,host/*.clas.abap}}"
    }
  ],
  "syntax": {
    "version": "open-abap",
    "errorNamespace": "."
  },
  "rules": {
    "method_length": {"statements": 100, "severity": "Warning"},
    "cyclomatic_complexity": {"max": 20, "severity": "Warning"},
    "7bit_ascii": true,
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "check_ddic": true,
    "check_abstract": true,
    "begin_end_names": true,
    "unreachable_code": true,
    "contains_tab": true,
    "whitespace_end": true,
    "keyword_case": {
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false
    },
    "indentation": {
      "ignoreExceptions": true,
      "alignTryCatch": false
    },
    "downport": true,
    "sql_escape_host_variables": false,
    "strict_sql": true,
    "when_others_last": true,
    "line_only_punc": true,
    "empty_statement": true,
    "space_before_dot": true,
    "max_one_statement": true,
    "definitions_top": true,
    "local_class_naming": {
      "local": "^LCL_.+$",
      "exception": "^LCX_.+$",
      "test": "^LTCL_.+$"
    }
  }
}
